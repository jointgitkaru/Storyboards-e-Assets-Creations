      ]
    },
    {
      "id": "scale-sheet",
      "order": 2,
      "name": "Escala 2×2 lata 33cl (trava DIMENSÃO — opcional)",
      "kind": "protocol",
      "protocol": "scale-invocation",
      "optional": true,
      "tool_hint": "GPT Image 2 / Nano Banana",
      "gates": [
        {
          "type": "flag",
          "slot": "dimensions_verified",
          "value": true,
          "message": "GATE (escala v1.0): Do NOT guess dimensions — medida não confirmada → PARAR E PERGUNTAR. Confirme a fonte da medida e registre: engine.py set <slug> dimensions_verified=true"
        }
      ]
    },
    {
      "id": "reference-image",
      "order": 3,
      "name": "Reference image (define o LOOK — BASE + 1 registro)",
      "kind": "template",
      "template": "reference-image",
      "tool_hint": "Midjourney / GPT Image 2 / Nano Banana",
      "slots": [
        "TITLE",
        "SUBJECT",
        "SCENE",
        "FRAMING",
        "ASPECT_RATIO"
      ],
      "gates": [
        {
          "type": "style_register",
          "message": "GATE (módulo de estilo): um registro por produção, do início ao fim. Escolha A, B ou C: engine.py set <slug> register=B"
        }
      ]
    },
    {
      "id": "depth-map",
      "order": 4,
      "name": "Depth map (grayscale — branco=perto, preto=longe)",
      "kind": "protocol",
      "protocol": "depth-map",
      "tool_hint": "Nano Banana / GPT Image 2 — cole junto da reference image",
      "gates": [
        {
          "type": "artifact",
          "pattern": "reference-image.*",
          "in": "renders",
          "message": "GATE: o depth map se extrai DA reference image. Gere/coloque a reference image em renders/ antes."
        }
      ]
    },
