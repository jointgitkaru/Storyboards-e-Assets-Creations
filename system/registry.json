    {
      "id": "character-sheet",
      "order": 1,
      "name": "Character reference sheet (trava IDENTIDADE)",
      "kind": "protocol",
      "protocol": "character-sheet",
      "tool_hint": "GPT Image 2 / Nano Banana — com a imagem de referência anexada",
      "gates": [
        {
          "type": "file_exists",
          "slot": "reference_image",
          "in": "assets",
          "message": "GATE (protocolo v2.0): sem imagem de referência → NÃO GERAR. Anexe a referência em assets/ e registre o nome com: engine.py set <slug> reference_image=<arquivo>"
